{
  "name": "vire",
  "version": "0.1.0",
  "description": "Vire: a free Russian course for the phone (PWA)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev && python3 -m http.server 8080 --directory dist",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "e2e": "node tests/e2e.mjs",
    "e2e:full": "node tests/e2e.mjs --full",
    "check": "tsc -p . && vitest run && node scripts/build.mjs && node tests/e2e.mjs"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "private": true,
  "type": "module"
}