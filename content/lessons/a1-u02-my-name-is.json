  "title": "My name is…",
  "goal": "Say who you are, ask someone's name, introduce another person.",
  "grammar": [
    {
      "title": "No 'am / is / are'",
      "explanation": "In the present tense Russian drops the verb 'to be'. 'I am Maria' is simply Я Мари́я. 'He is a student' is Он студе́нт."
    },
    {
      "title": "Меня́ зову́т = my name is",
      "explanation": "Меня́ зову́т literally means 'they call me'. Как тебя́ зову́т? (to a friend) and Как вас зову́т? (polite) both mean 'What is your name?'"
    },
    {
      "title": "Personal pronouns",
      "explanation": "я (I), ты (you, informal), он (he), она́ (she), мы (we), вы (you, polite or plural), они́ (they)."
    }
  ],
