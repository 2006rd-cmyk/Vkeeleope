  "pronunciation_rules": [
    {
      "title": "Stress matters",
      "explanation": "Every word has one stressed vowel (marked with ´ in this course). Stress is not written in normal Russian texts, so learn it with each word."
    },
    {
      "title": "Unstressed О sounds like А",
      "explanation": "молоко́ (milk) is said 'malakó'. хорошо́ is said 'kharashó'."
    },
    {
      "title": "Unstressed Е and Я sound close to И",
      "explanation": "сестра́ sounds like 'sistrá'. язы́к sounds like 'yizýk'."
    },
    {
      "title": "Voiced consonants go voiceless at the end of a word",
      "explanation": "хлеб (bread) is said 'khlep'. год (year) is said 'got'."
    },
    {
      "title": "Г is said as В in -ого / -его",
      "explanation": "его́ (him/his) is said 'yivó'. сего́дня (today) is said 'sivódnya'."
    }
  ]
