  "dialogue": {
    "title": "Early bird",
    "lines": [
      {
        "speaker": "Аня",
        "ru": "Марк, когда ты встаёшь?",
        "stress": "Марк, когда́ ты встаёшь?",
        "translit": "Mark, kogdá ty vstayosh'?",
        "en": "Mark, when do you get up?"
      },
      {
        "speaker": "Марк",
        "ru": "Обычно в семь часов. Потом я завтракаю и иду в школу.",
        "stress": "Обы́чно в семь часо́в. Пото́м я за́втракаю и иду́ в шко́лу.",
        "translit": "Obýchno v sem' chasóv. Potóm ya závtrakayu i idú v shkólu.",
        "en": "Usually at seven. Then I have breakfast and go to school."
      },
      {
        "speaker": "Аня",
        "ru": "А я встаю в шесть часов.",
        "stress": "А я встаю́ в шесть часо́в.",
        "translit": "A ya vstayú v shest' chasóv.",
        "en": "And I get up at six."
      },
      {
        "speaker": "Марк",
        "ru": "Почему так рано?",
        "stress": "Почему́ так ра́но?",
        "translit": "Pochemú tak ráno?",
        "en": "Why so early?"
      },
      {
        "speaker": "Аня",
        "ru": "Потому что я работаю утром.",
        "stress": "Потому́ что я рабо́таю у́тром.",
        "translit": "Potomú chto ya rabótayu útrom.",
        "en": "Because I work in the morning."
      }
    ],
