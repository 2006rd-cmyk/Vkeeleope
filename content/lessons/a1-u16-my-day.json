  "grammar": [
    {
      "title": "-ся verbs",
      "explanation": "Some verbs end in -ся (doing it to yourself): просыпа́ться (to wake up), умыва́ться (to wash). After a vowel -ся becomes -сь: я просыпа́юсь, ты просыпа́ешься, он просыпа́ется, мы просыпа́емся, они́ просыпа́ются."
    },
    {
      "title": "в + time",
      "explanation": "At seven o'clock = в семь часо́в. Early = ра́но, late = по́здно, usually = обы́чно."
    }
  ],
