  "section": "A1.1",
  "number": 3,
  "title": "Where I'm from",
  "goal": "Say where you are from and which language you speak.",
  "grammar": [
    {
      "title": "из + country or city",
      "explanation": "'From' is из, and the place name changes its ending (genitive case). Learn these as ready-made chunks for now: Росси́я → из Росси́и, Эсто́ния → из Эсто́нии, Москва́ → из Москвы́, Та́ллин → из Та́ллина. Pattern: -ия → -ии, -а → -ы, consonant → add -а."
    },
    {
      "title": "Nationality: male and female forms",
      "explanation": "ру́сский (a Russian man) / ру́сская (a Russian woman); эсто́нец (an Estonian man) / эсто́нка (an Estonian woman)."
    },
    {
      "title": "Speaking a language: по-…",
      "explanation": "говори́ть по-ру́сски = to speak Russian. я говорю́, ты говори́шь, он/она́ говори́т."
    }
  ],
