  "grammar": [
    {
      "title": "Ordering",
      "explanation": "Мне + what you want (no change): Мне ко́фе, пожа́луйста. Or Да́йте, пожа́луйста… + accusative: Да́йте, пожа́луйста, сала́т."
    },
    {
      "title": "с + instrumental = with",
      "explanation": "Learn as chunks: чай с молоко́м (tea with milk), ко́фе с са́харом (coffee with sugar)."
    },
    {
      "title": "рубль / рубля́ / рубле́й",
      "explanation": "Same rule as год: 1 рубль, 2–4 рубля́, 5–20 рубле́й. 100 = сто, 200 = две́сти, 300 = три́ста, 400 = четы́реста, 500 = пятьсо́т, 1000 = ты́сяча."
    }
