  "level": "A1",
  "section": "A1.2",
  "number": 11,
  "title": "Days and time",
  "goal": "Say what day it is, tell the time, say when something happens.",
  "grammar": [
    {
      "title": "в + day of the week",
      "explanation": "'On Monday' is в + the day, and -а days change to -у: в понеде́льник, во вто́рник, в сре́ду, в четве́рг, в пя́тницу, в суббо́ту, в воскресе́нье."
    },
    {
      "title": "час / часа́ / часо́в",
      "explanation": "Same rule as год: 1 → час (Сейча́с час), 2–4 → часа́ (два часа́), 5–20 → часо́в (пять часо́в). 'At three o'clock' = в три часа́."
    },
    {
      "title": "Parts of the day",
      "explanation": "у́тром (in the morning), днём (in the afternoon), ве́чером (in the evening), но́чью (at night)."
    }
  ],
