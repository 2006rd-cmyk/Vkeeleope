  "grammar": [
    {
      "title": "идти́ vs е́хать",
      "explanation": "идти́ = to go on foot: я иду́, ты идёшь, он идёт, мы идём, они́ иду́т. е́хать = to go by vehicle: я е́ду, ты е́дешь, он е́дет, мы е́дем, они́ е́дут."
    },
    {
      "title": "на + transport",
      "explanation": "'By bus' = на авто́бусе (prepositional). на метро́, на такси́ never change. On foot = пешко́м."
    },
    {
      "title": "Where to: в / на + accusative",
      "explanation": "Я е́ду в Москву́. Я иду́ на остано́вку. Masculine places do not change: Я е́ду в центр."
    }
